{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "byte-buddy-lounge",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "LOUNGE_ALLOWED_ORGS": ""
  },
  "containers": [
    {
      "class_name": "LoungeContainer",
      "scheduling_policy": "default",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOUNGE",
        "class_name": "LoungeContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoungeContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
